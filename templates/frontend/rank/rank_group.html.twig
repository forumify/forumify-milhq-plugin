<ul>
    {% for rank in ranks %}
        <li class="card flex flex-col mb-4">
            <div class="card-title">
                {{ rank.name }}
            </div>
            <div class="card-body grid gap-4">
                <div class="col-xs-12 col-sm-3 col-lg-2 flex flex-col items-center">
                    {% if rank.image %}
                        <img src="{{ asset(rank.image, 'milhq.asset') }}" width="100%" height="auto">
                    {% endif %}
                    <div class="text-small">
                        <span class="text-bold">{{ rank.paygrade }}</span> | {{ rank.abbreviation }}
                    </div>
                </div>
                <div class="col-xs-12 col-sm-9 col-lg-10">
                    {{ rank.description|milhq_text }}
                </div>
            </div>
        </li>
    {% else %}
        <li>{{ 'milhq.rank.no_ranks'|trans }}</li>
    {% endfor %}
</ul>
